{
  "name": "galerymanager",
  "version": "1.0.0",
  "description": "",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "dev:renderer": "vite --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.config.ts",
    "start:electron": "electron .",
    "dev": "npm run build:main && concurrently -k \"npm:dev:renderer\" \"wait-on tcp:5173 && npm run start:electron\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
